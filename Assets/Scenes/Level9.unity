  rightPortrait: {fileID: 388713822}
  nameText: {fileID: 133554354}
  dialogueText: {fileID: 1028233745}
  dialogue:
  - characterName: Boss
    text: So you finally arrived...
    leftPortrait: {fileID: 21300000, guid: c881dee3fa216f141a5ada9170c52aee, type: 3}
    rightPortrait: {fileID: 21300000, guid: 70f9ec1d7495d6643a4c5ffe4ebc9506, type: 3}
  - characterName: Outono
    text: Your show ends today!
    leftPortrait: {fileID: 21300000, guid: c881dee3fa216f141a5ada9170c52aee, type: 3}
    rightPortrait: {fileID: 21300000, guid: 70f9ec1d7495d6643a4c5ffe4ebc9506, type: 3}
  - characterName: Boss
    text: Hahaha! Let's find out!
    leftPortrait: {fileID: 21300000, guid: c881dee3fa216f141a5ada9170c52aee, type: 3}
    rightPortrait: {fileID: 21300000, guid: 70f9ec1d7495d6643a4c5ffe4ebc9506, type: 3}
  - characterName: Outono
    text: Give me back my best friend!
    leftPortrait: {fileID: 21300000, guid: c881dee3fa216f141a5ada9170c52aee, type: 3}
    rightPortrait: {fileID: 21300000, guid: 70f9ec1d7495d6643a4c5ffe4ebc9506, type: 3}
  - characterName: Boss
    text: you'll have to beat me at the circus balls! Are you ready?
    leftPortrait: {fileID: 21300000, guid: c881dee3fa216f141a5ada9170c52aee, type: 3}
    rightPortrait: {fileID: 21300000, guid: 70f9ec1d7495d6643a4c5ffe4ebc9506, type: 3}
  textSpeed: 0.03
  countdown: {fileID: 186350867}
